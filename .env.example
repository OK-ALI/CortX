# Local runtime
OLLAMA_URL=http://localhost:11434
LOCAL_MODEL=llama3.1:8b-instruct-q5_K_M
ENABLE_OLLAMA_CHAINS=true
ENABLE_LLM_SYNTHESIS=true
ENABLE_LLM_RESULT_REFINEMENT=true
OLLAMA_TIMEOUT_SECONDS=45
OLLAMA_KEEP_ALIVE=30m
WARMUP_OLLAMA_ON_START=true
UNLOAD_OLLAMA_ON_EXIT=true

# App behavior
LOG_LEVEL=INFO
MAX_URLS=8
CACHE_TTL_SECONDS=86400
