/* ============================================================
   CortX — Light Theme (Premium)
   ============================================================ */

QMainWindow {
    background: #FFFFFF;
    color: #1F2328;
    font-family: "Segoe UI", "Inter", sans-serif;
    font-size: 13px;
}

QWidget#RootContainer {
    background: #FFFFFF;
}

QWidget#ChatArea {
    background: #FFFFFF;
}

/* ============================================================
   SIDEBAR
   ============================================================ */

QWidget#Sidebar {
    background: #F6F8FA;
    border: none;
}

QWidget#SidebarContent {
    background: transparent;
}

QFrame#SidebarTop {
    background: transparent;
    border: none;
}

/* New Chat Button — glow border on hover */
QPushButton#NewChatBtn {
    background: #FFFFFF;
    color: #1F2328;
    border: 2px solid #D0D7DE;
    border-radius: 10px;
    padding: 8px 14px;
    font-size: 14px;
    font-weight: 600;
}

QPushButton#NewChatBtn:hover {
    border: 2px solid #54AEF0;
    color: #0550AE;
}

QPushButton#NewChatBtn:pressed {
    border: 2px solid #388BFD;
}

/* Sidebar scroll */
QScrollArea#SidebarScroll {
    background: transparent;
    border: none;
}

QWidget#SidebarList {
    background: transparent;
}

/* Chat items */
QFrame#ChatItem {
    background: transparent;
    border: none;
    border-radius: 10px;
    padding: 0px 4px;
}

QFrame#ChatItem:hover {
    background: rgba(9, 105, 218, 0.06);
    border: 1px solid rgba(9, 105, 218, 0.3);
    border-radius: 10px;
}

QFrame#ChatItem[active="true"] {
    background: rgba(9, 105, 218, 0.10);
    border: 1px solid #54AEF0;
    border-radius: 10px;
}

QLabel#ChatItemTitle {
    color: #1F2328;
    font-size: 13px;
    padding: 0px;
}

QLineEdit#ChatItemEditor {
    background: #FFFFFF;
    color: #1F2328;
    border: 1px solid #54AEF0;
    border-radius: 4px;
    padding: 2px 6px;
    font-size: 13px;
}

QPushButton#ChatItemDelete,
QPushButton#ChatItemRename {
    background: transparent;
    color: #8C959F;
    border: none;
    font-size: 13px;
    border-radius: 4px;
}

QPushButton#ChatItemDelete:hover {
    background: #FFEBE9;
    color: #CF222E;
}

QPushButton#ChatItemRename:hover {
    background: #DBEAF8;
    color: #0969DA;
}

/* Sidebar bottom */
QFrame#SidebarBottom {
    background: transparent;
    border-top: 1px solid #D8DEE4;
}

QLabel#SidebarThemeLabel {
    color: #656D76;
    font-size: 12px;
}

QLabel#SidebarBrand {
    color: #0969DA;
    font-size: 15px;
    font-weight: 700;
}

QAbstractButton#ThemeSwitch {
    background: transparent;
    border: none;
}

/* Sidebar divider */
QFrame#SidebarDivider {
    background: #D8DEE4;
    border: none;
}

QSplitter#RootSplitter::handle {
    background: #d8e0ea;
}

QSplitter#RootSplitter::handle:hover {
    background: #54aef0;
}

/* ============================================================
   CHAT TOP BAR
   ============================================================ */

QWidget#ChatTopBar {
    background: #f8fafc;
    border-bottom: 1px solid #d5dde6;
}

QPushButton#SidebarToggle {
    background: #f1f5f9;
    color: #5f6b78;
    border: 1px solid #d3dce7;
    border-radius: 9px;
    font-size: 16px;
    font-weight: 600;
}

QPushButton#SidebarToggle:hover {
    border: 1px solid #54AEF0;
    color: #0969DA;
}

QPushButton#ExportChatBtn {
    background: #f1f5f9;
    color: #4f6276;
    border: 1px solid #d3dce7;
    border-radius: 9px;
    padding: 6px 12px;
    font-size: 12px;
    font-weight: 600;
}

QPushButton#ExportChatBtn:hover {
    border: 1px solid #54AEF0;
    color: #0b5db9;
}

QPushButton#ExportChatBtn:pressed {
    background: #e9f0f8;
}

QPushButton#MotionPresetBtn {
    background: #f1f5f9;
    color: #4f6276;
    border: 1px solid #d3dce7;
    border-radius: 9px;
    padding: 6px 10px;
    font-size: 12px;
    font-weight: 600;
}

QPushButton#MotionPresetBtn:hover {
    border: 1px solid #54AEF0;
    color: #0b5db9;
}

QPushButton#MotionPresetBtn:pressed {
    background: #e9f0f8;
}

/* ============================================================
   CHAT AREA
   ============================================================ */

QWidget#ChatWidget,
QWidget#ChatViewport {
    background: transparent;
}

QScrollArea#ChatScroll {
    background: #FFFFFF;
    border: none;
}

QScrollBar:vertical {
    width: 8px;
    margin: 4px 2px;
    background: transparent;
}

QScrollBar::handle:vertical {
    background: #C4D3E3;
    border-radius: 4px;
    min-height: 20px;
}

QScrollBar::handle:vertical:hover {
    background: #AEBFD2;
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
    height: 0px;
}

/* Welcome message */
QLabel#WelcomeMessage {
    color: #9aa4af;
    font-size: 28px;
    font-weight: 300;
    padding: 96px 40px;
}

/* --- Message Cards --- */

QFrame#MessageCard_user {
    background: #ffffff;
    border: 1px solid #dbe2ea;
    border-radius: 16px;
}
QFrame#MessageCard_user[isPrevious="true"][hovered="true"] {
    background: #d6f2e4;
    border: 1px solid #9edabd;
}
QFrame#MessageCard_user[contextTarget="true"] {
    background: #e8f2fb;
    border: 1px solid #6da8db;
}

QFrame#MessageCard_assistant {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1, stop:0 #f7f9fb, stop:1 #eef3f8);
    border: 1px solid #d4dce5;
    border-radius: 16px;
}
QFrame#MessageCard_assistant[isPrevious="true"][hovered="true"] {
    background: #f5f9fd;
    border: 1px solid #a8bfd6;
}
QFrame#MessageCard_assistant[contextTarget="true"] {
    background: #e8f2fb;
    border: 1px solid #6da8db;
}

QFrame#MessageCard_status {
    background: transparent;
    border: none;
}

QLabel#MessageBody {
    color: #000000;
    font-size: 14px;
    line-height: 1.5;
}

QTextBrowser#UserBody {
    background: transparent;
    color: #1f2328;
    font-size: 14px;
    border: none;
    selection-background-color: #DBEAF8;
}

QLabel#UserContextHint {
    color: #4c647c;
    background: #e8f1fb;
    border: 1px solid #bfd7ee;
    border-radius: 8px;
    padding: 3px 8px;
    font-size: 11px;
    font-weight: 600;
}

SpinnerWidget#StatusSpinner {
    qproperty-spinnerColor: #0969DA;
}

QLabel#StatusBody {
    color: #0969DA;
    font-size: 13px;
    font-style: italic;
}

/* Assistant markdown body */
QTextBrowser#AssistantBody {
    background: transparent;
    color: #1F2328;
    font-size: 14px;
    line-height: 1.65;
    border: none;
    selection-background-color: #DBEAF8;
}

/* Sources */
QFrame#SourceSeparator {
    background: #D0D7DE;
    border: none;
}

QLabel#SourceHeader {
    color: #656D76;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 1px;
}

QLabel#SourceLink {
    color: #0969DA;
    font-size: 12px;
}

/* ============================================================
   INPUT BAR — gradient glow
   ============================================================ */

QWidget#InputBar {
    background: #FFFFFF;
    border: none;
}

QWidget#InputContainer {
    background: #f5f8fb;
    border: 2px solid #D0D7DE;
    border-radius: 20px;
}

QWidget#InputContainer:hover {
    border: 2px solid #54AEF0;
}

QWidget#InputContextStrip {
    background: #edf2f8;
    border: 1px solid #d3dbe4;
    border-radius: 10px;
}

QWidget#InputContextStrip[hasTarget="true"] {
    border: 1px solid #7bb5e6;
}

QLabel#InputContextMode {
    background: #d6e5f5;
    color: #34506e;
    border-radius: 8px;
    padding: 3px 9px;
    font-size: 11px;
    font-weight: 700;
}

QLabel#InputContextPreview {
    color: #6f7f8f;
    font-size: 12px;
}

QPushButton#InputContextClear {
    background: transparent;
    color: #8394a6;
    border: none;
    border-radius: 6px;
    font-size: 11px;
}

QPushButton#InputContextClear:hover {
    background: #dce8f4;
    color: #2f4f73;
}

QTextEdit#Composer {
    background: transparent;
    color: #1F2328;
    border: none;
    padding: 8px 6px;
    font-size: 14px;
}

QTextEdit#Composer[contextPrefill="true"] {
    color: #6f7f8f;
}

QPushButton#SendButton {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1, stop:0 #0969DA, stop:1 #388BFD);
    color: #FFFFFF;
    border: 1px solid transparent;
    border-radius: 12px;
    font-size: 16px;
    font-weight: 700;
}

QPushButton#SendButton:hover {
    border: 1px solid #42A5F5;
}

QPushButton#SendButton:pressed {
    border: 1px solid #0550AE;
}

QPushButton#SendButton:disabled {
    background: #EAEEF2;
    color: #8C959F;
    border: none;
}
